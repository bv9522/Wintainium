<Window
    x:Class="Wintainium.Desktop.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="ms-appx:///Cyberwave2000-Regular.otf#Cyberwave 2000" />
                <Setter Property="Foreground" Value="#765CFF" />
            </Style>
            <Style TargetType="ToggleSwitch">
                <Setter Property="FontFamily" Value="ms-appx:///Cyberwave2000-Regular.otf#Cyberwave 2000" />
                <Setter Property="Foreground" Value="#765CFF" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="FontFamily" Value="ms-appx:///Cyberwave2000-Regular.otf#Cyberwave 2000" />
                <Setter Property="Foreground" Value="#765CFF" />
            </Style>
            <Style TargetType="ListView">
                <Setter Property="FontFamily" Value="ms-appx:///Cyberwave2000-Regular.otf#Cyberwave 2000" />
                <Setter Property="Foreground" Value="#765CFF" />
            </Style>
            <Style TargetType="ListViewItem">
                <Setter Property="FontFamily" Value="ms-appx:///Cyberwave2000-Regular.otf#Cyberwave 2000" />
                <Setter Property="Foreground" Value="#765CFF" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="Y2KTitleBar" Grid.Row="0" Visibility="Collapsed" Height="32" Padding="16,0,0,0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F4F7F9" Offset="0" />
                    <GradientStop Color="#C7D2D9" Offset="0.22" />
                    <GradientStop Color="#71828C" Offset="0.48" />
                    <GradientStop Color="#D9E2E7" Offset="0.70" />
                    <GradientStop Color="#8A9AA4" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <TextBlock x:Name="Y2KTitleBarText" Text="Wintainium Settings" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="#765CFF" />
        </Grid>

        <Grid Grid.Row="1" Padding="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Text="Settings"
            Style="{StaticResource WintainiumY2KTitleTextBlockStyle}"
            FontSize="28"
            FontWeight="SemiBold"
            Margin="0,0,0,20" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView SelectedIndex="0">
                <ListViewItem Content="General" />
                <ListViewItem Content="Appearance" />
                <ListViewItem Content="Updates" />
                <ListViewItem Content="Sources" />
                <ListViewItem Content="Advanced" />
            </ListView>

            <Border
                Grid.Column="1"
                Margin="24,0,0,0"
                Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Text="General"
                            Style="{StaticResource WintainiumY2KSubtitleTextBlockStyle}"
                            FontSize="20"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="General Wintainium behavior and preferences."
                            TextWrapping="Wrap"
                            Opacity="0.72" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</Window>
