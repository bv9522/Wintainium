<Window
    x:Class="Wintainium.Desktop.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Text="Settings"
            FontSize="28"
            FontWeight="SemiBold"
            Margin="0,0,0,20" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView SelectedIndex="0">
                <ListViewItem Content="General" />
                <ListViewItem Content="Appearance" />
                <ListViewItem Content="Updates" />
                <ListViewItem Content="Sources" />
                <ListViewItem Content="Advanced" />
            </ListView>

            <Border
                Grid.Column="1"
                Margin="24,0,0,0"
                Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="General"
                        FontSize="20"
                        FontWeight="SemiBold" />
                    <TextBlock
                        Text="General Wintainium behavior and preferences."
                        TextWrapping="Wrap"
                        Opacity="0.72" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
