<Window
    x:Class="Wintainium.Desktop.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Margin="28,24,28,16"
            Text="Settings"
            FontSize="28"
            FontWeight="SemiBold" />

        <Grid Grid.Row="1" Margin="28,0,28,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView
                x:Name="CategoryList"
                SelectionChanged="CategoryList_SelectionChanged"
                SelectedIndex="0">
                <ListViewItem Content="General" />
                <ListViewItem Content="Appearance" />
                <ListViewItem Content="Updates" />
                <ListViewItem Content="Sources" />
                <ListViewItem Content="Advanced" />
            </ListView>

            <Border
                Grid.Column="1"
                Margin="24,0,0,0"
                Padding="24"
                CornerRadius="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock
                                x:Name="CategoryTitle"
                                Text="General"
                                FontSize="20"
                                FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="CategoryDescription"
                                Text="General Wintainium behavior and preferences."
                                TextWrapping="Wrap"
                                Opacity="0.72" />
                        </StackPanel>

                        <StackPanel
                            x:Name="CategoryContent"
                            Spacing="12" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
