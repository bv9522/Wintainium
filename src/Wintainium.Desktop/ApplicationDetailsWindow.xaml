<Window
    x:Class="Wintainium.Desktop.ApplicationDetailsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="28">
        <ScrollViewer>
            <StackPanel Spacing="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="ApplicationNameText"
                                   FontSize="28"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Application Details"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Opacity="0.72" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8">
                        <Button x:Name="CheckForUpdatesButton"
                                Content="Check for Updates"
                                Click="CheckForUpdatesButton_Click" />
                        <Button x:Name="RunUpdateButton"
                                Content="Run Update"
                                Click="RunUpdateButton_Click" />
                    </StackPanel>
                </Grid>

                <Border Padding="18">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Application Icon"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />

                        <Border Grid.Row="0"
                                Grid.Column="1"
                                Width="32"
                                Height="32"
                                Margin="0"
                                RenderTransform="{TranslateTransform X=-50}"
                                CornerRadius="8"
                                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                            <Grid>
                                <TextBlock x:Name="ApplicationIconGlyph"
                                           Text="&#xE71D;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Image x:Name="ApplicationIconImage"
                                       Stretch="Uniform"
                                       Visibility="Collapsed"
                                       Margin="8" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Spacing="8">
                            <TextBlock x:Name="ApplicationIconStatusText"
                                       Text="No Icon"
                                       Opacity="0.68"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Choose Image…" Click="ChooseIconButton_Click" />
                                <Button Content="Use Icon URL…" Click="UseIconUrlButton_Click" />
                                <Button x:Name="ResetIconButton"
                                        Content="Reset to Automatic"
                                        Click="ResetIconButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Padding="18">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Application Information"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Identity and current application state"
                                   Opacity="0.65" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Application ID" Opacity="0.60" />
                            <TextBlock x:Name="ApplicationIdText"
                                       Grid.Row="0"
                                       Grid.Column="1"
                                       TextWrapping="Wrap" />

                            <TextBlock Grid.Row="1" Text="Installed version" Opacity="0.60" />
                            <TextBlock x:Name="InstalledVersionText"
                                       Grid.Row="1"
                                       Grid.Column="1" />

                            <TextBlock Grid.Row="2" Text="Installation state" Opacity="0.60" />
                            <TextBlock x:Name="InstallationStateText"
                                       Grid.Row="2"
                                       Grid.Column="1" />

                            <TextBlock Grid.Row="3" Text="Update status" Opacity="0.60" />
                            <TextBlock x:Name="UpdateStatusText"
                                       Grid.Row="3"
                                       Grid.Column="1" />

                            <TextBlock Grid.Row="4" Text="Source provider" Opacity="0.60" />
                            <TextBlock x:Name="SourceText"
                                       Grid.Row="4"
                                       Grid.Column="1"
                                       TextWrapping="Wrap" />

                        </Grid>
                        <HyperlinkButton x:Name="HomepageButton"
                                         Content="Open source homepage"
                                         HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <Border Padding="18">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Update Policy"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <CheckBox x:Name="DoNotUpdateCheckBox"
                                  Content="Do Not Update"
                                  IsEnabled="False" />
                        <TextBlock Text="Policy persistence and update-policy enforcement are reserved for the later application-policy/configuration boundary."
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                    </StackPanel>
                </Border>

                <Border Padding="18">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Operation Status"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Core operation results and diagnostics"
                                   Opacity="0.65" />
                        <TextBlock x:Name="OperationStateText"
                                   Text="Not started." />
                        <TextBlock x:Name="OperationIdText"
                                   Opacity="0.65"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="UpdateResultStatusText"
                                   Text="No update has been run."
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="InstalledStateRefreshStatusText"
                                   Text="Installed state has not been refreshed."
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                        <TextBlock Text="Lifecycle stages"
                                   FontWeight="SemiBold" />
                        <ItemsControl x:Name="StageItemsControl" />
                        <TextBlock Text="Errors"
                                   FontWeight="SemiBold" />
                        <ItemsControl x:Name="ErrorItemsControl" />
                        <TextBlock Text="Warnings"
                                   FontWeight="SemiBold" />
                        <ItemsControl x:Name="WarningItemsControl" />
                    </StackPanel>
                </Border>

                <Border Padding="18">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Release Information"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Releases reported by the application's declared source"
                                   Opacity="0.65"
                                   TextWrapping="Wrap" />
                        <Button x:Name="CancelOperationButton"
                                Content="Cancel"
                                IsEnabled="False"
                                Click="CancelOperationButton_Click"
                                HorizontalAlignment="Left" />
                        <ProgressRing x:Name="OperationProgressRing"
                                      IsActive="False"
                                      Width="20"
                                      Height="20" />
                        <TextBlock x:Name="ReleaseStatusText"
                                   Text="No release check has been performed." />
                        <ListView x:Name="ReleaseListView"
                                  MaxHeight="240"
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="0,6" Spacing="3">
                                        <TextBlock Text="{Binding Version}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Channel}"
                                                   Opacity="0.72" />
                                        <TextBlock Text="{Binding PublishedAt, TargetNullValue=Publication date unavailable}"
                                                   Opacity="0.72" />
                                        <TextBlock Text="{Binding ArtifactSummary}"
                                                   Opacity="0.72"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Padding="18">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Notes"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Optional notes kept for this application session"
                                   Opacity="0.65" />
                        <TextBox x:Name="NotesTextBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="120"
                                 PlaceholderText="Add notes about this software." />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="8">
                            <Button Content="Don't Save"
                                    Click="DontSaveButton_Click" />
                            <Button Content="Save"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="SaveNotesButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="NotesStatusText"
                                   Opacity="0.72" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="DetailsErrorText"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>