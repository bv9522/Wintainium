<Window
    x:Class="Wintainium.Desktop.ApplicationDetailsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="28">
        <ScrollViewer>
            <StackPanel Spacing="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="ApplicationNameText"
                                   FontSize="28"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="ApplicationPublisherText"
                                   Opacity="0.72" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8">
                        <Button x:Name="CheckForUpdatesButton"
                                Content="Check for Updates"
                                Click="CheckForUpdatesButton_Click" />
                        <Button x:Name="RunUpdateButton"
                                Content="Run Update"
                                Click="RunUpdateButton_Click" />
                    </StackPanel>
                </Grid>

                <Border Padding="18">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Application"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="ApplicationIdText" />
                        <TextBlock x:Name="InstalledVersionText" />
                        <TextBlock x:Name="InstallationStateText" />
                        <TextBlock x:Name="SourceText" />
                        <HyperlinkButton x:Name="HomepageButton"
                                         Content="Open source homepage" />
                    </StackPanel>
                </Border>

                <Border Padding="18">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Update Policy"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <CheckBox x:Name="DoNotUpdateCheckBox"
                                  Content="Do Not Update"
                                  IsEnabled="False" />
                        <TextBlock Text="Policy persistence and update-policy enforcement are reserved for the later application-policy/configuration boundary."
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                    </StackPanel>
                </Border>

                <Border Padding="18">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Operation Status"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="OperationStateText"
                                   Text="Not started." />
                        <TextBlock x:Name="OperationIdText"
                                   Opacity="0.65"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="UpdateResultStatusText"
                                   Text="No update has been run."
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="InstalledStateRefreshStatusText"
                                   Text="Installed state has not been refreshed."
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                        <TextBlock Text="Lifecycle stages"
                                   FontWeight="SemiBold" />
                        <ItemsControl x:Name="StageItemsControl" />
                        <TextBlock Text="Errors"
                                   FontWeight="SemiBold" />
                        <ItemsControl x:Name="ErrorItemsControl" />
                        <TextBlock Text="Warnings"
                                   FontWeight="SemiBold" />
                        <ItemsControl x:Name="WarningItemsControl" />
                    </StackPanel>
                </Border>

                <Border Padding="18">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Release Information"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Button x:Name="CancelOperationButton"
                                Content="Cancel"
                                IsEnabled="False"
                                Click="CancelOperationButton_Click"
                                HorizontalAlignment="Left" />
                        <ProgressRing x:Name="OperationProgressRing"
                                      IsActive="False"
                                      Width="20"
                                      Height="20" />
                        <TextBlock x:Name="ReleaseStatusText"
                                   Text="No release check has been performed." />
                        <ListView x:Name="ReleaseListView"
                                  MaxHeight="240"
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="0,6" Spacing="3">
                                        <TextBlock Text="{Binding Version}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Channel}"
                                                   Opacity="0.72" />
                                        <TextBlock Text="{Binding PublishedAt, TargetNullValue=Publication date unavailable}"
                                                   Opacity="0.72" />
                                        <TextBlock Text="{Binding ArtifactSummary}"
                                                   Opacity="0.72"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Padding="18">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Notes"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBox x:Name="NotesTextBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="120"
                                 PlaceholderText="Add notes about this software." />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="8">
                            <Button Content="Don't Save"
                                    Click="DontSaveButton_Click" />
                            <Button Content="Save"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="SaveNotesButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="NotesStatusText"
                                   Opacity="0.72" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="DetailsErrorText"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>