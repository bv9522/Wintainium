<Window
    x:Class="Wintainium.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Frutiger Aero Light-only scenic backdrop. Kept isolated from all other visual styles. -->
        <Grid x:Name="FrutigerAeroBackdrop" Grid.RowSpan="4" IsHitTestVisible="False" Visibility="Collapsed">
            <Image Source="ms-appx:///Themes/New%20York%20Eco-Utopia%20Seascape.png"
                   Stretch="Fill"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch" />
            <!-- A very light aqua wash keeps the supplied artwork prominent while helping controls remain legible. -->
            <Rectangle Fill="#100B5368" />
            <!-- Subtle glassy highlights; the supplied artwork remains the dominant visual. -->
            <Ellipse Width="150" Height="150" Fill="#20FFFFFF" Stroke="#55FFFFFF" StrokeThickness="1.5"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="58,46,0,0" />
            <Ellipse Width="64" Height="64" Fill="#20FFFFFF" Stroke="#66FFFFFF" StrokeThickness="1"
                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,110,86,0" />
            <Ellipse Width="28" Height="28" Fill="#30FFFFFF" Stroke="#77FFFFFF" StrokeThickness="1"
                     HorizontalAlignment="Center" VerticalAlignment="Top" Margin="180,30,0,0" />
        </Grid>


        <!-- Frutiger Metro DARK-only native vector poster art; no bitmap and no hit testing. -->
        <Grid x:Name="FrutigerMetroBackdrop" Grid.RowSpan="4" IsHitTestVisible="False" Visibility="Collapsed">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF09090C" Offset="0" />
                    <GradientStop Color="#FF19141C" Offset="0.48" />
                    <GradientStop Color="#FF08090D" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Viewbox Stretch="UniformToFill">
                <Canvas Width="1600" Height="900">
                    <!-- Black-keylined streamlines and saturated ribbon trails -->
                    <Path Data="M-100,170 C180,15 370,270 610,130 S1050,5 1710,155" Stroke="#FF000000" StrokeThickness="30" />
                    <Path Data="M-100,170 C180,15 370,270 610,130 S1050,5 1710,155" Stroke="#FFFFC928" StrokeThickness="15" />
                    <Path Data="M-100,204 C180,49 370,304 610,164 S1050,39 1710,189" Stroke="#FF00D9D0" StrokeThickness="5" />
                    <Path Data="M-100,735 C180,575 410,830 680,670 S1190,565 1710,735" Stroke="#FF000000" StrokeThickness="34" />
                    <Path Data="M-100,735 C180,575 410,830 680,670 S1190,565 1710,735" Stroke="#FFFFC928" StrokeThickness="16" />
                    <Path Data="M-100,765 C180,605 410,860 680,700 S1190,595 1710,765" Stroke="#FFFF3B87" StrokeThickness="5" />
                    <Path Data="M0,410 C260,320 370,450 590,365 S1050,300 1600,420" Stroke="#FF000000" StrokeThickness="12" />
                    <Path Data="M0,410 C260,320 370,450 590,365 S1050,300 1600,420" Stroke="#FF7D42FF" StrokeThickness="4" />
                    <Polygon Points="0,0 180,0 640,900 500,900" Fill="#FF000000" Opacity="0.62" />
                    <Polygon Points="0,0 104,0 564,900 500,900" Fill="#FFFFC928" Opacity="0.13" />
                    <Polygon Points="1480,0 1600,0 1110,900 1000,900" Fill="#FF000000" Opacity="0.6" />
                    <Polygon Points="1540,0 1600,0 1110,900 1060,900" Fill="#FF00D9D0" Opacity="0.13" />
                    <!-- Record discs, layered grooves and black outlines -->
                    <Ellipse Canvas.Left="75" Canvas.Top="250" Width="230" Height="230" Fill="#FF000000" Stroke="#FFFFC928" StrokeThickness="8" />
                    <Ellipse Canvas.Left="91" Canvas.Top="266" Width="198" Height="198" Fill="#FF28202C" Stroke="#FFFF3B87" StrokeThickness="4" />
                    <Ellipse Canvas.Left="111" Canvas.Top="286" Width="158" Height="158" Stroke="#FF7D42FF" StrokeThickness="3" />
                    <Ellipse Canvas.Left="133" Canvas.Top="308" Width="114" Height="114" Stroke="#FFFFC928" StrokeThickness="3" />
                    <Ellipse Canvas.Left="166" Canvas.Top="341" Width="48" Height="48" Fill="#FFFFC928" Stroke="#FF000000" StrokeThickness="5" />
                    <Ellipse Canvas.Left="1370" Canvas.Top="420" Width="190" Height="190" Fill="#FF000000" Stroke="#FF00D9D0" StrokeThickness="8" />
                    <Ellipse Canvas.Left="1386" Canvas.Top="436" Width="158" Height="158" Fill="#FF29202D" Stroke="#FFFF3B87" StrokeThickness="4" />
                    <Ellipse Canvas.Left="1408" Canvas.Top="458" Width="114" Height="114" Stroke="#FFFFC928" StrokeThickness="3" />
                    <Ellipse Canvas.Left="1440" Canvas.Top="490" Width="50" Height="50" Fill="#FF00D9D0" Stroke="#FF000000" StrokeThickness="5" />
                    <!-- Oversized comic-book starbursts -->
                    <Polygon Points="390,50 411,113 470,80 439,139 507,151 442,172 480,229 421,199 403,267 382,203 326,237 353,176 286,163 349,143 314,85 374,113" Fill="#FFFFC928" Stroke="#FF000000" StrokeThickness="7" />
                    <Polygon Points="1250,170 1265,219 1310,194 1287,238 1337,248 1289,264 1315,309 1268,286 1253,336 1237,287 1193,311 1216,265 1168,251 1215,237 1190,194 1236,219" Fill="#FFFF3B87" Stroke="#FF000000" StrokeThickness="7" />
                    <Polygon Points="1120,610 1135,650 1176,634 1155,670 1196,686 1154,696 1169,738 1133,715 1110,753 1105,711 1061,720 1088,686 1054,658 1098,664" Fill="#FF00D9D0" Stroke="#FF000000" StrokeThickness="6" />
                    <!-- The W emblem: geometric, musical-poster bold, black keyline -->
                    <Path Data="M510,310 L625,570 L800,365 L975,570 L1090,310" Stroke="#FF000000" StrokeThickness="42" StrokeLineJoin="Round" />
                    <Path Data="M510,310 L625,570 L800,365 L975,570 L1090,310" Stroke="#FFFFC928" StrokeThickness="27" StrokeLineJoin="Round" />
                    <Path Data="M510,310 L625,570 L800,365 L975,570 L1090,310" Stroke="#FFFFFFFF" StrokeThickness="3" StrokeLineJoin="Round" Opacity="0.82" />
                    <!-- Supporting rings, stars, spark marks and dot trails -->
                    <Ellipse Canvas.Left="1040" Canvas.Top="70" Width="72" Height="72" Stroke="#FF000000" StrokeThickness="10" />
                    <Ellipse Canvas.Left="1040" Canvas.Top="70" Width="72" Height="72" Stroke="#FF00D9D0" StrokeThickness="4" />
                    <Ellipse Canvas.Left="535" Canvas.Top="690" Width="82" Height="82" Stroke="#FF000000" StrokeThickness="10" />
                    <Ellipse Canvas.Left="535" Canvas.Top="690" Width="82" Height="82" Stroke="#FFFF3B87" StrokeThickness="4" />
                    <Polygon Points="730,90 742,120 775,122 750,143 758,175 730,157 702,175 710,143 685,122 718,120" Fill="#FF00D9D0" Stroke="#FF000000" StrokeThickness="4" />
                    <Polygon Points="900,710 910,736 938,738 916,756 923,784 900,768 877,784 884,756 862,738 890,736" Fill="#FFFFC928" Stroke="#FF000000" StrokeThickness="4" />
                    <Path Data="M0,95 L35,95 M17,77 L17,113 M1550,330 L1590,330 M1570,310 L1570,350 M330,815 L370,815 M350,795 L350,835" Stroke="#FF000000" StrokeThickness="9" />
                    <Path Data="M0,95 L35,95 M17,77 L17,113 M1550,330 L1590,330 M1570,310 L1570,350 M330,815 L370,815 M350,795 L350,835" Stroke="#FFFFC928" StrokeThickness="3" />
                    <Ellipse Canvas.Left="460" Canvas.Top="75" Width="7" Height="7" Fill="#FFFFC928" />
                    <Ellipse Canvas.Left="482" Canvas.Top="91" Width="7" Height="7" Fill="#FFFFC928" />
                    <Ellipse Canvas.Left="504" Canvas.Top="107" Width="7" Height="7" Fill="#FFFFC928" />
                    <Ellipse Canvas.Left="526" Canvas.Top="123" Width="7" Height="7" Fill="#FFFFC928" />
                    <Ellipse Canvas.Left="548" Canvas.Top="139" Width="7" Height="7" Fill="#FFFFC928" />
                    <Ellipse Canvas.Left="1150" Canvas.Top="810" Width="7" Height="7" Fill="#FF00D9D0" />
                    <Ellipse Canvas.Left="1172" Canvas.Top="826" Width="7" Height="7" Fill="#FF00D9D0" />
                    <Ellipse Canvas.Left="1194" Canvas.Top="842" Width="7" Height="7" Fill="#FF00D9D0" />
                    <Ellipse Canvas.Left="1216" Canvas.Top="858" Width="7" Height="7" Fill="#FF00D9D0" />
                </Canvas>
            </Viewbox>
            <Rectangle Fill="#5807070B" />
        </Grid>

        <Grid
            x:Name="Y2KTitleBar"
            Grid.Row="0"
            Visibility="Collapsed"
            Height="32"
            Padding="16,0,0,0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F4F7F9" Offset="0" />
                    <GradientStop Color="#C7D2D9" Offset="0.22" />
                    <GradientStop Color="#71828C" Offset="0.48" />
                    <GradientStop Color="#D9E2E7" Offset="0.70" />
                    <GradientStop Color="#8A9AA4" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <TextBlock
                    x:Name="Y2KTitleBarText"
                    Text="Wintainium"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="#765CFF" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="28,24,28,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
<StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock
                        Text="My Software"
                        Style="{StaticResource WintainiumY2KTitleTextBlockStyle}" />
                    <TextBlock
                        Text="Software tracked by Wintainium"
                        Style="{StaticResource WintainiumY2KBodyTextBlockStyle}"
                        Opacity="0.72" />
                </StackPanel>
            </StackPanel>

            <TextBlock
                x:Name="ApplicationSummaryText"
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="4"
                Margin="0,8,0,0"
                Text="0 applications"
                Opacity="0.60" />

            <Button
                Grid.Row="0"
                Grid.Column="1"
                Margin="12,0,8,0"
                Content="&#xE16E;  Sort &amp; Filter"
                Click="SortAndFilterButton_Click" />

            <Button
                x:Name="ViewModeButton"
                Grid.Row="0"
                Grid.Column="2"
                Margin="0,0,8,0"
                Content="Grid"
                Click="ViewModeButton_Click"
                ToolTipService.ToolTip="Switch to grid view" />

            <Button
                Grid.Row="0"
                Grid.Column="3"
                Content="Settings"
                Click="SettingsButton_Click" />
        </Grid>

        <Grid Grid.Row="2" Margin="28,0,28,16">
            <GridView
                x:Name="ApplicationGridView"
                Visibility="Collapsed"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemClick="ApplicationGridView_ItemClick"
                Padding="4"
                HorizontalAlignment="Stretch">
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border Width="240" Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" RightTapped="ApplicationItem_RightTapped" Loaded="SoftwareCard_Loaded">
                            <StackPanel Spacing="10">
                                <Border Width="52" Height="52" CornerRadius="10" HorizontalAlignment="Left" Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                    <Grid>
                                        <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding IconUri}"
                                               Stretch="Uniform"
                                               Margin="8" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="2" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Padding="8,4" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock Text="{Binding InstallationStateText}" />
                                    </Border>
                                    <Border Padding="8,4" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock Text="{Binding UpdateStatusText}" />
                                    </Border>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Installed" FontSize="11" Opacity="0.55" />
                                        <TextBlock Text="{Binding InstalledVersionText}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                                        <TextBlock Text="Available" FontSize="11" Opacity="0.55" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding AvailableVersionText}" HorizontalAlignment="Right" Opacity="0.78" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <ListView
                x:Name="ApplicationListView"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemClick="ApplicationListView_ItemClick"
                Padding="4">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,2" Padding="12" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" RightTapped="ApplicationItem_RightTapped" Loaded="SoftwareCard_Loaded">
                        <Grid MinHeight="64">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="8" VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding IconUri}"
                                           Stretch="Uniform"
                                           Margin="7" />
                                </Grid>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DisplayName}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="2" />
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="4">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Installed" FontSize="11" Opacity="0.55" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding InstalledVersionText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Available" FontSize="11" Opacity="0.55" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding AvailableVersionText}" Opacity="0.78" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                    <TextBlock Text="{Binding InstallationStateText}" />
                                    <TextBlock Text="{Binding UpdateStatusText}" Opacity="0.72" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel
                x:Name="EmptyStatePanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10"
                MaxWidth="520">
                <TextBlock Text="Your software collection"
                           Style="{StaticResource WintainiumY2KSubtitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Applications you add to Wintainium will appear here."
                           Style="{StaticResource WintainiumY2KBodyTextBlockStyle}"
                           TextAlignment="Center"
                           Opacity="0.72"
                           TextWrapping="Wrap" />
                <TextBlock
                    x:Name="CollectionLoadingText"
                    Text="Loading your software collection…"
                    HorizontalAlignment="Center"
                    Opacity="0.60"
                    Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Padding="28,12,28,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Wintainium" VerticalAlignment="Center" Opacity="0.45" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="&#xE72C;  Refresh" Click="RefreshButton_Click" />
                <Button Content="&#xE710;  Add Software" FontWeight="SemiBold" Click="AddSoftwareButton_Click" />
            </StackPanel>
        </Grid>
            <Grid x:Name="Y2KHexTelemetry" Grid.RowSpan="4" IsHitTestVisible="False" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HexReadout1" Grid.Row="0" Grid.Column="0" Text="W1NTA1N1UM" Foreground="#39FF9A" FontFamily="Consolas" FontSize="12" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,24,0,0" />
                <TextBlock x:Name="HexReadout2" Grid.Row="0" Grid.Column="1" Text="1NSTALL" Foreground="#39FF9A" FontFamily="Consolas" FontSize="11" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0" />
                <TextBlock x:Name="HexReadout3" Grid.Row="0" Grid.Column="2" Text="UPD4TE" Foreground="#39FF9A" FontFamily="Consolas" FontSize="12" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0" />
                <TextBlock x:Name="HexReadout4" Grid.Row="0" Grid.Column="3" Text="M4NAGE" Foreground="#39FF9A" FontFamily="Consolas" FontSize="11" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,28,28,0" />
                <TextBlock x:Name="HexReadout5" Grid.Row="1" Grid.Column="0" Text="5OFTWARE" Foreground="#39FF9A" FontFamily="Consolas" FontSize="11" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBlock x:Name="HexReadout6" Grid.Row="1" Grid.Column="1" Text="APPL1CAT1ON" Foreground="#39FF9A" FontFamily="Consolas" FontSize="12" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="18,0,0,22" />
                <TextBlock x:Name="HexReadout7" Grid.Row="1" Grid.Column="2" Text="V3R1FY" Foreground="#39FF9A" FontFamily="Consolas" FontSize="12" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,26,18,0" />
                <TextBlock x:Name="HexReadout8" Grid.Row="1" Grid.Column="3" Text="D0WNLOAD" Foreground="#39FF9A" FontFamily="Consolas" FontSize="11" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12,0,0" />
                <TextBlock x:Name="HexReadout9" Grid.Row="2" Grid.Column="0" Text="1NTEGR1TY" Foreground="#39FF9A" FontFamily="Consolas" FontSize="12" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0" />
                <TextBlock x:Name="HexReadout10" Grid.Row="2" Grid.Column="1" Text="0RCH3STRATE" Foreground="#39FF9A" FontFamily="Consolas" FontSize="11" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,0,0" />
                <TextBlock x:Name="HexReadout11" Grid.Row="2" Grid.Column="2" Text="PR0V1DER" Foreground="#39FF9A" FontFamily="Consolas" FontSize="12" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0" />
                <TextBlock x:Name="HexReadout12" Grid.Row="2" Grid.Column="3" Text="C0RE" Foreground="#39FF9A" FontFamily="Consolas" FontSize="11" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" />
                <TextBlock x:Name="HexReadout13" Grid.Row="3" Grid.Column="0" Text="P4CKAGE" Foreground="#39FF9A" FontFamily="Consolas" FontSize="11" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="28,0,0,0" />
                <TextBlock x:Name="HexReadout14" Grid.Row="3" Grid.Column="1" Text="4RT1FACT" Foreground="#39FF9A" FontFamily="Consolas" FontSize="12" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,18" />
                <TextBlock x:Name="HexReadout15" Grid.Row="3" Grid.Column="2" Text="5OURCE" Foreground="#39FF9A" FontFamily="Consolas" FontSize="11" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,0" />
                <TextBlock x:Name="HexReadout16" Grid.Row="3" Grid.Column="3" Text="5YNC" Foreground="#39FF9A" FontFamily="Consolas" FontSize="12" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,16,0,0" />
                <TextBlock x:Name="HexReadout17" Grid.Row="4" Grid.Column="0" Text="L1FECYCLE" Foreground="#39FF9A" FontFamily="Consolas" FontSize="11" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0" />
                <TextBlock x:Name="HexReadout18" Grid.Row="4" Grid.Column="1" Text="5CAN" Foreground="#39FF9A" FontFamily="Consolas" FontSize="12" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="24,0,0,0" />
                <TextBlock x:Name="HexReadout19" Grid.Row="4" Grid.Column="2" Text="4PPLY" Foreground="#39FF9A" FontFamily="Consolas" FontSize="12" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0" />
                <TextBlock x:Name="HexReadout20" Grid.Row="4" Grid.Column="3" Text="R3CONC1LE" Foreground="#39FF9A" FontFamily="Consolas" FontSize="11" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22" />
                <TextBlock x:Name="HexReadout21" Grid.Row="5" Grid.Column="0" Text="W1NTA1N1UM.EXE" Foreground="#39FF9A" FontFamily="Consolas" FontSize="11" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,10,0,0" />
                <TextBlock x:Name="HexReadout22" Grid.Row="5" Grid.Column="1" Text="UPD4TE" Foreground="#39FF9A" FontFamily="Consolas" FontSize="12" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0" />
                <TextBlock x:Name="HexReadout23" Grid.Row="5" Grid.Column="2" Text="1NSTALLER" Foreground="#39FF9A" FontFamily="Consolas" FontSize="11" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0" />
                <TextBlock x:Name="HexReadout24" Grid.Row="5" Grid.Column="3" Text="M4NAGER" Foreground="#39FF9A" FontFamily="Consolas" FontSize="12" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,12,22,0" />
            </Grid>

    </Grid>

</Window>
