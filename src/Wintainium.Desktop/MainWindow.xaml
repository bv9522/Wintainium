<Window
    x:Class="Wintainium.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="28,24,28,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock
                    Text="My Software"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="Software tracked by Wintainium"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Opacity="0.72" />
            </StackPanel>

            <Button
                Grid.Column="1"
                Margin="12,0,8,0"
                Content="Sort &amp; Filter"
                Click="SortAndFilterButton_Click" />

            <Button
                Grid.Column="2"
                Content="Settings"
                Click="SettingsButton_Click" />
        </Grid>

        <Grid Grid.Row="1" Margin="28,0,28,16">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10"
                MaxWidth="520">
                <TextBlock
                    Text="Your software collection"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Text="Applications you add to Wintainium will appear here."
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextAlignment="Center"
                    Opacity="0.72"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Padding="28,12,28,24">
            <Button
                HorizontalAlignment="Right"
                Content="&#xE710;  Add Software"
                FontWeight="SemiBold"
                Click="AddSoftwareButton_Click" />
        </Grid>
    </Grid>
</Window>
