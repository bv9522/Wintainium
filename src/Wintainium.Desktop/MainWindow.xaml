<Window
    x:Class="Wintainium.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Frutiger Aero-only glass skyline decoration; the app's controls remain above it. -->
        <Grid x:Name="FrutigerAeroBackdrop" Grid.RowSpan="4" IsHitTestVisible="False" Visibility="Collapsed">
            <Ellipse Width="116" Height="116" Fill="#99FFFFFF" Stroke="#CCFFFFFF" StrokeThickness="2"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="72,72,0,0" />
            <Ellipse Width="54" Height="54" Fill="#77FFFFFF" Stroke="#AAFFFFFF" StrokeThickness="1.5"
                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,132,96,0" />
            <Ellipse Width="30" Height="30" Fill="#AAFFFFFF" Stroke="#CCFFFFFF" StrokeThickness="1"
                     HorizontalAlignment="Center" VerticalAlignment="Top" Margin="180,36,0,0" />
            <Canvas Height="250" VerticalAlignment="Bottom">
                <Border Canvas.Left="0" Canvas.Top="132" Width="88" Height="118" CornerRadius="7,7,0,0"
                        Background="#55FFFFFF" BorderBrush="#88FFFFFF" BorderThickness="1" />
                <Border Canvas.Left="78" Canvas.Top="92" Width="66" Height="158" CornerRadius="6,6,0,0"
                        Background="#77D7F7F4" BorderBrush="#CCFFFFFF" BorderThickness="1" />
                <Border Canvas.Left="136" Canvas.Top="45" Width="48" Height="205" CornerRadius="5,5,0,0"
                        Background="#99FFFFFF" BorderBrush="#CCFFFFFF" BorderThickness="1" />
                <Border Canvas.Left="151" Canvas.Top="18" Width="18" Height="28"
                        Background="#88FFFFFF" BorderBrush="#CCFFFFFF" BorderThickness="1" />
                <Border Canvas.Left="158" Canvas.Top="0" Width="4" Height="20" Background="#CCFFFFFF" />
                <Border Canvas.Left="190" Canvas.Top="112" Width="70" Height="138" CornerRadius="6,6,0,0"
                        Background="#66BEEDE9" BorderBrush="#AAFFFFFF" BorderThickness="1" />
                <Border Canvas.Left="254" Canvas.Top="74" Width="60" Height="176" CornerRadius="5,5,0,0"
                        Background="#88FFFFFF" BorderBrush="#CCFFFFFF" BorderThickness="1" />
                <Border Canvas.Left="278" Canvas.Top="42" Width="12" Height="34" Background="#99FFFFFF" />
                <Border Canvas.Left="322" Canvas.Top="138" Width="84" Height="112" CornerRadius="6,6,0,0"
                        Background="#66D6F6F2" BorderBrush="#AAFFFFFF" BorderThickness="1" />
                <Border Canvas.Left="400" Canvas.Top="98" Width="58" Height="152" CornerRadius="5,5,0,0"
                        Background="#88FFFFFF" BorderBrush="#CCFFFFFF" BorderThickness="1" />
                <Border Canvas.Left="448" Canvas.Top="154" Width="78" Height="96" CornerRadius="5,5,0,0"
                        Background="#55FFFFFF" BorderBrush="#AAFFFFFF" BorderThickness="1" />
                <Border Canvas.Left="514" Canvas.Top="122" Width="62" Height="128" CornerRadius="5,5,0,0"
                        Background="#66BEEDE9" BorderBrush="#AAFFFFFF" BorderThickness="1" />
                <Border Canvas.Left="566" Canvas.Top="58" Width="46" Height="192" CornerRadius="5,5,0,0"
                        Background="#99FFFFFF" BorderBrush="#CCFFFFFF" BorderThickness="1" />
                <Border Canvas.Left="584" Canvas.Top="18" Width="10" Height="42" Background="#AAFFFFFF" />
                <Border Canvas.Left="604" Canvas.Top="138" Width="84" Height="112" CornerRadius="5,5,0,0"
                        Background="#55FFFFFF" BorderBrush="#AAFFFFFF" BorderThickness="1" />
                <Border Canvas.Left="680" Canvas.Top="90" Width="70" Height="160" CornerRadius="5,5,0,0"
                        Background="#77D7F7F4" BorderBrush="#CCFFFFFF" BorderThickness="1" />
                <Border Canvas.Left="742" Canvas.Top="128" Width="88" Height="122" CornerRadius="5,5,0,0"
                        Background="#55FFFFFF" BorderBrush="#AAFFFFFF" BorderThickness="1" />
                <Border Canvas.Left="820" Canvas.Top="72" Width="62" Height="178" CornerRadius="5,5,0,0"
                        Background="#88FFFFFF" BorderBrush="#CCFFFFFF" BorderThickness="1" />
                <Border Canvas.Left="874" Canvas.Top="148" Width="90" Height="102" CornerRadius="5,5,0,0"
                        Background="#55FFFFFF" BorderBrush="#AAFFFFFF" BorderThickness="1" />
                <Border Canvas.Left="0" Canvas.Top="236" Width="1100" Height="14" Background="#66FFFFFF" />
            </Canvas>
        </Grid>

        <Grid
            x:Name="Y2KTitleBar"
            Grid.Row="0"
            Visibility="Collapsed"
            Height="32"
            Padding="16,0,0,0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F4F7F9" Offset="0" />
                    <GradientStop Color="#C7D2D9" Offset="0.22" />
                    <GradientStop Color="#71828C" Offset="0.48" />
                    <GradientStop Color="#D9E2E7" Offset="0.70" />
                    <GradientStop Color="#8A9AA4" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <TextBlock
                    x:Name="Y2KTitleBarText"
                    Text="Wintainium"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="#765CFF" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="28,24,28,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
<StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock
                        Text="My Software"
                        Style="{StaticResource WintainiumY2KTitleTextBlockStyle}" />
                    <TextBlock
                        Text="Software tracked by Wintainium"
                        Style="{StaticResource WintainiumY2KBodyTextBlockStyle}"
                        Opacity="0.72" />
                </StackPanel>
            </StackPanel>

            <TextBlock
                x:Name="ApplicationSummaryText"
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="4"
                Margin="0,8,0,0"
                Text="0 applications"
                Opacity="0.60" />

            <Button
                Grid.Row="0"
                Grid.Column="1"
                Margin="12,0,8,0"
                Content="&#xE16E;  Sort &amp; Filter"
                Click="SortAndFilterButton_Click" />

            <Button
                x:Name="ViewModeButton"
                Grid.Row="0"
                Grid.Column="2"
                Margin="0,0,8,0"
                Content="Grid"
                Click="ViewModeButton_Click"
                ToolTipService.ToolTip="Switch to grid view" />

            <Button
                Grid.Row="0"
                Grid.Column="3"
                Content="Settings"
                Click="SettingsButton_Click" />
        </Grid>

        <Grid Grid.Row="2" Margin="28,0,28,16">
            <GridView
                x:Name="ApplicationGridView"
                Visibility="Collapsed"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemClick="ApplicationGridView_ItemClick"
                Padding="4"
                HorizontalAlignment="Stretch">
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border Width="240" Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" RightTapped="ApplicationItem_RightTapped" Loaded="SoftwareCard_Loaded">
                            <StackPanel Spacing="10">
                                <Border Width="52" Height="52" CornerRadius="10" HorizontalAlignment="Left" Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                    <Grid>
                                        <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding IconUri}"
                                               Stretch="Uniform"
                                               Margin="8" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="2" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Padding="8,4" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock Text="{Binding InstallationStateText}" />
                                    </Border>
                                    <Border Padding="8,4" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock Text="{Binding UpdateStatusText}" />
                                    </Border>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Installed" FontSize="11" Opacity="0.55" />
                                        <TextBlock Text="{Binding InstalledVersionText}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                                        <TextBlock Text="Available" FontSize="11" Opacity="0.55" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding AvailableVersionText}" HorizontalAlignment="Right" Opacity="0.78" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <ListView
                x:Name="ApplicationListView"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemClick="ApplicationListView_ItemClick"
                Padding="4">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,2" Padding="12" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" RightTapped="ApplicationItem_RightTapped" Loaded="SoftwareCard_Loaded">
                        <Grid MinHeight="64">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="8" VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding IconUri}"
                                           Stretch="Uniform"
                                           Margin="7" />
                                </Grid>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DisplayName}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="2" />
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="4">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Installed" FontSize="11" Opacity="0.55" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding InstalledVersionText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Available" FontSize="11" Opacity="0.55" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding AvailableVersionText}" Opacity="0.78" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                    <TextBlock Text="{Binding InstallationStateText}" />
                                    <TextBlock Text="{Binding UpdateStatusText}" Opacity="0.72" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel
                x:Name="EmptyStatePanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10"
                MaxWidth="520">
                <TextBlock Text="Your software collection"
                           Style="{StaticResource WintainiumY2KSubtitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Applications you add to Wintainium will appear here."
                           Style="{StaticResource WintainiumY2KBodyTextBlockStyle}"
                           TextAlignment="Center"
                           Opacity="0.72"
                           TextWrapping="Wrap" />
                <TextBlock
                    x:Name="CollectionLoadingText"
                    Text="Loading your software collection…"
                    HorizontalAlignment="Center"
                    Opacity="0.60"
                    Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Padding="28,12,28,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Wintainium" VerticalAlignment="Center" Opacity="0.45" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="&#xE72C;  Refresh" Click="RefreshButton_Click" />
                <Button Content="&#xE710;  Add Software" FontWeight="SemiBold" Click="AddSoftwareButton_Click" />
            </StackPanel>
        </Grid>
            <Grid x:Name="Y2KHexTelemetry" Grid.RowSpan="4" IsHitTestVisible="False" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HexReadout1" Grid.Row="0" Grid.Column="0" Text="W1NTA1N1UM" Foreground="#39FF9A" FontFamily="Consolas" FontSize="12" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,24,0,0" />
                <TextBlock x:Name="HexReadout2" Grid.Row="0" Grid.Column="1" Text="1NSTALL" Foreground="#39FF9A" FontFamily="Consolas" FontSize="11" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0" />
                <TextBlock x:Name="HexReadout3" Grid.Row="0" Grid.Column="2" Text="UPD4TE" Foreground="#39FF9A" FontFamily="Consolas" FontSize="12" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0" />
                <TextBlock x:Name="HexReadout4" Grid.Row="0" Grid.Column="3" Text="M4NAGE" Foreground="#39FF9A" FontFamily="Consolas" FontSize="11" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,28,28,0" />
                <TextBlock x:Name="HexReadout5" Grid.Row="1" Grid.Column="0" Text="5OFTWARE" Foreground="#39FF9A" FontFamily="Consolas" FontSize="11" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBlock x:Name="HexReadout6" Grid.Row="1" Grid.Column="1" Text="APPL1CAT1ON" Foreground="#39FF9A" FontFamily="Consolas" FontSize="12" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="18,0,0,22" />
                <TextBlock x:Name="HexReadout7" Grid.Row="1" Grid.Column="2" Text="V3R1FY" Foreground="#39FF9A" FontFamily="Consolas" FontSize="12" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,26,18,0" />
                <TextBlock x:Name="HexReadout8" Grid.Row="1" Grid.Column="3" Text="D0WNLOAD" Foreground="#39FF9A" FontFamily="Consolas" FontSize="11" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12,0,0" />
                <TextBlock x:Name="HexReadout9" Grid.Row="2" Grid.Column="0" Text="1NTEGR1TY" Foreground="#39FF9A" FontFamily="Consolas" FontSize="12" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0" />
                <TextBlock x:Name="HexReadout10" Grid.Row="2" Grid.Column="1" Text="0RCH3STRATE" Foreground="#39FF9A" FontFamily="Consolas" FontSize="11" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,0,0" />
                <TextBlock x:Name="HexReadout11" Grid.Row="2" Grid.Column="2" Text="PR0V1DER" Foreground="#39FF9A" FontFamily="Consolas" FontSize="12" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0" />
                <TextBlock x:Name="HexReadout12" Grid.Row="2" Grid.Column="3" Text="C0RE" Foreground="#39FF9A" FontFamily="Consolas" FontSize="11" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" />
                <TextBlock x:Name="HexReadout13" Grid.Row="3" Grid.Column="0" Text="P4CKAGE" Foreground="#39FF9A" FontFamily="Consolas" FontSize="11" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="28,0,0,0" />
                <TextBlock x:Name="HexReadout14" Grid.Row="3" Grid.Column="1" Text="4RT1FACT" Foreground="#39FF9A" FontFamily="Consolas" FontSize="12" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,18" />
                <TextBlock x:Name="HexReadout15" Grid.Row="3" Grid.Column="2" Text="5OURCE" Foreground="#39FF9A" FontFamily="Consolas" FontSize="11" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,0" />
                <TextBlock x:Name="HexReadout16" Grid.Row="3" Grid.Column="3" Text="5YNC" Foreground="#39FF9A" FontFamily="Consolas" FontSize="12" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,16,0,0" />
                <TextBlock x:Name="HexReadout17" Grid.Row="4" Grid.Column="0" Text="L1FECYCLE" Foreground="#39FF9A" FontFamily="Consolas" FontSize="11" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0" />
                <TextBlock x:Name="HexReadout18" Grid.Row="4" Grid.Column="1" Text="5CAN" Foreground="#39FF9A" FontFamily="Consolas" FontSize="12" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="24,0,0,0" />
                <TextBlock x:Name="HexReadout19" Grid.Row="4" Grid.Column="2" Text="4PPLY" Foreground="#39FF9A" FontFamily="Consolas" FontSize="12" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0" />
                <TextBlock x:Name="HexReadout20" Grid.Row="4" Grid.Column="3" Text="R3CONC1LE" Foreground="#39FF9A" FontFamily="Consolas" FontSize="11" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22" />
                <TextBlock x:Name="HexReadout21" Grid.Row="5" Grid.Column="0" Text="W1NTA1N1UM.EXE" Foreground="#39FF9A" FontFamily="Consolas" FontSize="11" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,10,0,0" />
                <TextBlock x:Name="HexReadout22" Grid.Row="5" Grid.Column="1" Text="UPD4TE" Foreground="#39FF9A" FontFamily="Consolas" FontSize="12" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0" />
                <TextBlock x:Name="HexReadout23" Grid.Row="5" Grid.Column="2" Text="1NSTALLER" Foreground="#39FF9A" FontFamily="Consolas" FontSize="11" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0" />
                <TextBlock x:Name="HexReadout24" Grid.Row="5" Grid.Column="3" Text="M4NAGER" Foreground="#39FF9A" FontFamily="Consolas" FontSize="12" CharacterSpacing="100" Opacity="0.38" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,12,22,0" />
            </Grid>

    </Grid>

</Window>
