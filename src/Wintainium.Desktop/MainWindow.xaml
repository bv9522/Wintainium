<Window
    x:Class="Wintainium.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="28,24,28,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock
                    Text="My Software"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="Software tracked by Wintainium"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Opacity="0.72" />
            </StackPanel>

            <Button
                Grid.Column="1"
                Margin="12,0,8,0"
                Content="Sort &amp; Filter"
                Click="SortAndFilterButton_Click" />

            <ComboBox
                x:Name="ViewModeComboBox"
                Grid.Column="2"
                Width="120"
                Margin="12,0,8,0"
                SelectionChanged="ViewModeComboBox_SelectionChanged">
                <ComboBoxItem Content="List" />
                <ComboBoxItem Content="Grid" />
            </ComboBox>

            <Button
                Grid.Column="3"
                Content="Settings"
                Click="SettingsButton_Click" />
        </Grid>

        <Grid Grid.Row="1" Margin="28,0,28,16">
                        <GridView
                x:Name="ApplicationGridView"
                Visibility="Collapsed"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemClick="ApplicationGridView_ItemClick">
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="220" Spacing="8" Padding="12">
                            <Border Width="64" Height="64" CornerRadius="12" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding InstalledVersion, TargetNullValue=Not installed}"
                                       Opacity="0.72" />
                            <TextBlock Text="{Binding UpdateStatus}" Opacity="0.72" />
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
<ListView
                x:Name="ApplicationListView"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemClick="ApplicationListView_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="8" VerticalAlignment="Center">
                                <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ApplicationId}" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="3">
                                <TextBlock Text="{Binding InstalledVersion, TargetNullValue=Not installed}"
                                           HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding UpdateStatus}" Opacity="0.72" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel
                x:Name="EmptyStatePanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10"
                MaxWidth="520">
                <TextBlock Text="Your software collection"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Applications you add to Wintainium will appear here."
                           Style="{StaticResource BodyTextBlockStyle}"
                           TextAlignment="Center"
                           Opacity="0.72"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Padding="28,12,28,24">
            <Button
                HorizontalAlignment="Right"
                Content="&#xE710;  Add Software"
                FontWeight="SemiBold"
                Click="AddSoftwareButton_Click" />
        </Grid>
    </Grid>
</Window>
