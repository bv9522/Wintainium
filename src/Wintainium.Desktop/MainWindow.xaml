<Window
    x:Class="Wintainium.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="32"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        </Grid>

        <Grid Grid.Row="1" Padding="28,24,28,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                <TextBlock
                    Text="My Software"
                    Style="{StaticResource WintainiumY2KTitleTextBlockStyle}" />
                <TextBlock
                        Text="Software tracked by Wintainium"
                    Style="{StaticResource WintainiumY2KBodyTextBlockStyle}"
                    Opacity="0.72" />
            </StackPanel>

            <TextBlock
                x:Name="ApplicationSummaryText"
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="4"
                Margin="0,8,0,0"
                Text="0 applications"
                Opacity="0.60" />

            <Button
                Grid.Row="0"
                Grid.Column="1"
                Margin="12,0,8,0"
                Content="&#xE16E;  Sort &amp; Filter"
                Click="SortAndFilterButton_Click" />

            <Button
                x:Name="ViewModeButton"
                Grid.Row="0"
                Grid.Column="2"
                Margin="0,0,8,0"
                Content="Grid"
                Click="ViewModeButton_Click"
                ToolTipService.ToolTip="Switch to grid view" />

            <Button
                Grid.Row="0"
                Grid.Column="3"
                Content="Settings"
                Click="SettingsButton_Click" />
        </Grid>

        <Grid Grid.Row="2" Margin="28,0,28,16">
            <GridView
                x:Name="ApplicationGridView"
                Visibility="Collapsed"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemClick="ApplicationGridView_ItemClick"
                Padding="4"
                HorizontalAlignment="Stretch">
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border Width="240" Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" RightTapped="ApplicationItem_RightTapped">
                            <StackPanel Spacing="10">
                                <Border Width="52" Height="52" CornerRadius="10" HorizontalAlignment="Left" Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                    <Grid>
                                        <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding IconUri}"
                                               Stretch="Uniform"
                                               Margin="8" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="2" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Padding="8,4" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock Text="{Binding InstallationStateText}" />
                                    </Border>
                                    <Border Padding="8,4" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock Text="{Binding UpdateStatusText}" />
                                    </Border>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Installed" FontSize="11" Opacity="0.55" />
                                        <TextBlock Text="{Binding InstalledVersionText}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                                        <TextBlock Text="Available" FontSize="11" Opacity="0.55" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding AvailableVersionText}" HorizontalAlignment="Right" Opacity="0.78" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <ListView
                x:Name="ApplicationListView"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemClick="ApplicationListView_ItemClick"
                Padding="4">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,2" Padding="12" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" RightTapped="ApplicationItem_RightTapped">
                        <Grid MinHeight="64">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="8" VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding IconUri}"
                                           Stretch="Uniform"
                                           Margin="7" />
                                </Grid>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DisplayName}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="2" />
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="4">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Installed" FontSize="11" Opacity="0.55" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding InstalledVersionText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Available" FontSize="11" Opacity="0.55" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding AvailableVersionText}" Opacity="0.78" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                    <TextBlock Text="{Binding InstallationStateText}" />
                                    <TextBlock Text="{Binding UpdateStatusText}" Opacity="0.72" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel
                x:Name="EmptyStatePanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10"
                MaxWidth="520">
                <TextBlock Text="Your software collection"
                           Style="{StaticResource WintainiumY2KSubtitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Applications you add to Wintainium will appear here."
                           Style="{StaticResource WintainiumY2KBodyTextBlockStyle}"
                           TextAlignment="Center"
                           Opacity="0.72"
                           TextWrapping="Wrap" />
                <TextBlock
                    x:Name="CollectionLoadingText"
                    Text="Loading your software collection…"
                    HorizontalAlignment="Center"
                    Opacity="0.60"
                    Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Padding="28,12,28,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Wintainium" VerticalAlignment="Center" Opacity="0.45" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="&#xE72C;  Refresh" Click="RefreshButton_Click" />
                <Button Content="&#xE710;  Add Software" FontWeight="SemiBold" Click="AddSoftwareButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
