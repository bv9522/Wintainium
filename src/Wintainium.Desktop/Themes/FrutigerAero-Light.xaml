<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Frutiger Aero LIGHT only. Kept in its own dictionary so this palette never leaks into Windows 11 or Y2K. -->
    <LinearGradientBrush x:Key="ApplicationPageBackgroundThemeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFBDEEFF" Offset="0" />
        <GradientStop Color="#FFEAFBFF" Offset="0.42" />
        <GradientStop Color="#FFB4E7E5" Offset="0.76" />
        <GradientStop Color="#FF72C8C5" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardBackgroundFillColorDefaultBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EFFFFFFF" Offset="0" />
        <GradientStop Color="#CFF8FFFF" Offset="0.5" />
        <GradientStop Color="#BFE0F7F5" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#BFFFFFFF" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#99D2F3EE" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF21AFA4" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FFB8F0E5" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FFE1F9F7" />
    <LinearGradientBrush x:Key="ControlFillColorDefaultBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F7FFFFFF" Offset="0" />
        <GradientStop Color="#CFF4FCFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#CFE6F7F7" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#A6FFFFFF" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#FF80CFCB" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FF174F67" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF28677A" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF28677A" />
    <SolidColorBrush x:Key="TextControlHeaderForeground" Color="#FF174F67" />
    <SolidColorBrush x:Key="ControlHeaderForeground" Color="#FF174F67" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF087D76" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#FF638C98" />
    <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#D9FFFFFF" />
    <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="#BFFFFFFF" />
    <SolidColorBrush x:Key="WintainiumFrutigerAeroGlassBrush" Color="#BFFFFFFF" />
    <SolidColorBrush x:Key="WintainiumFrutigerAeroGlassEdgeBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="WintainiumFrutigerAeroAquaBrush" Color="#FF35C9C0" />
    <SolidColorBrush x:Key="WintainiumFrutigerAeroLeafBrush" Color="#FF65C88C" />
    <FontFamily x:Key="WintainiumFrutigerAeroFontFamily">ms-appx:///Horatio%20D%20Regular.ttf#Horatio D</FontFamily>
    <CornerRadius x:Key="ControlCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">18</CornerRadius>
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource WintainiumFrutigerAeroFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource WintainiumFrutigerAeroFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource WintainiumFrutigerAeroFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource WintainiumFrutigerAeroFontFamily}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style TargetType="ToggleSwitch">
        <Setter Property="FontFamily" Value="{StaticResource WintainiumFrutigerAeroFontFamily}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style TargetType="HyperlinkButton">
        <Setter Property="FontFamily" Value="{StaticResource WintainiumFrutigerAeroFontFamily}" />
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
    </Style>
</ResourceDictionary>