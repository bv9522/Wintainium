<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Wintainium Y2K visual language
        Visual resource layer
        Resource-only theme layer. Do not add window/layout-specific resources here.
        Windows 11 keeps the native application presentation; this dictionary is only
        attached when the Y2K visual style is selected.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- Pearlescent silver / cool-white page surface -->
            <LinearGradientBrush x:Key="ApplicationPageBackgroundThemeBrush"
                                 StartPoint="0,0"
                                 EndPoint="1,1">
                <GradientStop Color="#E7EDF2" Offset="0" />
                <GradientStop Color="#D8E1E8" Offset="0.28" />
                <GradientStop Color="#C3D0DA" Offset="0.68" />
                <GradientStop Color="#DDE5EB" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="WintainiumY2KPageGlowBrush"
                                 StartPoint="0,0"
                                 EndPoint="1,1">
                <GradientStop Color="#E6EEF4" Offset="0" />
                <GradientStop Color="#D2E4EF" Offset="0.42" />
                <GradientStop Color="#C4D2DC" Offset="1" />
            </LinearGradientBrush>

            <!-- Frosted / metallic card surfaces -->
            <LinearGradientBrush x:Key="CardBackgroundFillColorDefaultBrush"
                                 StartPoint="0,0"
                                 EndPoint="0,1">
                <GradientStop Color="#E9EFF3" Offset="0" />
                <GradientStop Color="#DDE5EA" Offset="0.38" />
                <GradientStop Color="#CBD6DE" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#A9BBC9" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#D8E4ED" />

            <!-- Electric blue accent system -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#087FE5" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#C5E5FF" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#E8F5FF" />

            <!-- Native control surfaces -->
            <LinearGradientBrush x:Key="ControlFillColorDefaultBrush"
                                 StartPoint="0,0"
                                 EndPoint="0,1">
                <GradientStop Color="#E5EBEF" Offset="0" />
                <GradientStop Color="#D4DEE5" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#DFE8EF" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#96AAB9" />
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#C0CED8" />

            <!-- Typography -->
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#102235" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#38536B" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#62788B" />

            <!-- Y2K signature palette -->
            <LinearGradientBrush x:Key="WintainiumY2KChromeBrush"
                                 StartPoint="0,0"
                                 EndPoint="0,1">
                <GradientStop Color="#DCE3E8" Offset="0" />
                <GradientStop Color="#C7D1D8" Offset="0.34" />
                <GradientStop Color="#A8B7C1" Offset="0.58" />
                <GradientStop Color="#E3E9ED" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="WintainiumY2KChromeHighlightBrush" Color="#EAF0F4" />
            <SolidColorBrush x:Key="WintainiumY2KChromeEdgeBrush" Color="#8FA4B3" />
            <SolidColorBrush x:Key="WintainiumY2KElectricBlueBrush" Color="#007FCC" />
            <SolidColorBrush x:Key="WintainiumY2KVioletBrush" Color="#765CFF" />
            <SolidColorBrush x:Key="WintainiumY2KMatrixGreenBrush" Color="#18C96B" />
            <SolidColorBrush x:Key="WintainiumY2KOrangeBrush" Color="#E86F1D" />
            <SolidColorBrush x:Key="WintainiumY2KBlueGlowBrush" Color="#73CCFF" />
            <SolidColorBrush x:Key="WintainiumY2KGridLineBrush" Color="#4E91BC" Opacity="0.16" />
            <SolidColorBrush x:Key="WintainiumY2KGridAccentBrush" Color="#009DFF" Opacity="0.28" />

            <!-- Semantic accents for future Y2K surfaces/status indicators -->
            <SolidColorBrush x:Key="WintainiumY2KSuccessBrush" Color="#139B59" />
            <SolidColorBrush x:Key="WintainiumY2KWarningBrush" Color="#C76516" />
            <SolidColorBrush x:Key="WintainiumY2KErrorBrush" Color="#C83D4D" />

            <!-- Geometry -->
            <CornerRadius x:Key="ControlCornerRadius">9</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">14</CornerRadius>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <!-- Deep navy / black with restrained violet depth -->
            <LinearGradientBrush x:Key="ApplicationPageBackgroundThemeBrush"
                                 StartPoint="0,0"
                                 EndPoint="1,1">
                <GradientStop Color="#111D2B" Offset="0" />
                <GradientStop Color="#09131F" Offset="0.35" />
                <GradientStop Color="#07111C" Offset="0.62" />
                <GradientStop Color="#160F2D" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="WintainiumY2KPageGlowBrush"
                                 StartPoint="0,0"
                                 EndPoint="1,1">
                <GradientStop Color="#1A3044" Offset="0" />
                <GradientStop Color="#0C1E2E" Offset="0.5" />
                <GradientStop Color="#1B1235" Offset="1" />
            </LinearGradientBrush>

            <!-- Dark glass / metallic card surfaces -->
            <LinearGradientBrush x:Key="CardBackgroundFillColorDefaultBrush"
                                 StartPoint="0,0"
                                 EndPoint="0,1">
                <GradientStop Color="#1C3042" Offset="0" />
                <GradientStop Color="#132433" Offset="0.4" />
                <GradientStop Color="#0D1926" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#3B6F93" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#183248" />

            <!-- Electric blue accent system -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#009DFF" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#103A5D" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#0D253A" />

            <!-- Native control surfaces -->
            <LinearGradientBrush x:Key="ControlFillColorDefaultBrush"
                                 StartPoint="0,0"
                                 EndPoint="0,1">
                <GradientStop Color="#1A2D3F" Offset="0" />
                <GradientStop Color="#112130" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#1A3043" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#3B6F93" />
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#294D67" />

            <!-- Typography -->
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F1F7FC" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#B7D1E4" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#7FA2BA" />

            <!-- Y2K signature palette -->
            <LinearGradientBrush x:Key="WintainiumY2KChromeBrush"
                                 StartPoint="0,0"
                                 EndPoint="0,1">
                <GradientStop Color="#C7D4DC" Offset="0" />
                <GradientStop Color="#718493" Offset="0.38" />
                <GradientStop Color="#405363" Offset="0.6" />
                <GradientStop Color="#AFC0CB" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="WintainiumY2KChromeHighlightBrush" Color="#E7F4FC" />
            <SolidColorBrush x:Key="WintainiumY2KChromeEdgeBrush" Color="#49677D" />
            <SolidColorBrush x:Key="WintainiumY2KElectricBlueBrush" Color="#00B7FF" />
            <SolidColorBrush x:Key="WintainiumY2KVioletBrush" Color="#8C6CFF" />
            <SolidColorBrush x:Key="WintainiumY2KMatrixGreenBrush" Color="#39FF9A" />
            <SolidColorBrush x:Key="WintainiumY2KOrangeBrush" Color="#FF8B36" />
            <SolidColorBrush x:Key="WintainiumY2KBlueGlowBrush" Color="#42C7FF" />
            <SolidColorBrush x:Key="WintainiumY2KGridLineBrush" Color="#31B6FF" Opacity="0.20" />
            <SolidColorBrush x:Key="WintainiumY2KGridAccentBrush" Color="#00B7FF" Opacity="0.34" />

            <!-- Semantic accents for future Y2K surfaces/status indicators -->
            <SolidColorBrush x:Key="WintainiumY2KSuccessBrush" Color="#39FF9A" />
            <SolidColorBrush x:Key="WintainiumY2KWarningBrush" Color="#FF8B36" />
            <SolidColorBrush x:Key="WintainiumY2KErrorBrush" Color="#FF5D73" />

            <!-- Geometry -->
            <CornerRadius x:Key="ControlCornerRadius">9</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">14</CornerRadius>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Stable aliases used by future Y2K-specific styles/templates. -->
    <CornerRadius x:Key="WintainiumY2KCardCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="WintainiumY2KControlCornerRadius">9</CornerRadius>

    <Style x:Key="WintainiumY2KButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource WintainiumY2KControlCornerRadius}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="WintainiumY2KAccentButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource WintainiumY2KButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource WintainiumY2KElectricBlueBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="WintainiumY2KCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource WintainiumY2KCardCornerRadius}" />
    </Style>
</ResourceDictionary>
