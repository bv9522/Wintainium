<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:media="using:Microsoft.UI.Xaml.Media.Imaging">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <ImageBrush x:Key="ApplicationPageBackgroundThemeBrush" Stretch="UniformToFill">
                <ImageBrush.ImageSource>
                    <media:SvgImageSource UriSource="ms-appx:///Themes/Y2K-LightChrome.svg" />
                </ImageBrush.ImageSource>
            </ImageBrush>
            <LinearGradientBrush x:Key="WintainiumY2KPageGlowBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#D7E2E8" Offset="0" />
                <GradientStop Color="#9EAFB9" Offset="0.5" />
                <GradientStop Color="#7F909A" Offset="1" />
            </LinearGradientBrush>
            <ImageBrush x:Key="CardBackgroundFillColorDefaultBrush"
                        ImageSource="ms-appx:///Themes/Y2K-LightChrome.svg"
                        Stretch="UniformToFill"
                        Opacity="0.34" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#607887" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#D8E4ED" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#087FE5" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#C5E5FF" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#E8F5FF" />
            <LinearGradientBrush x:Key="ButtonBackground" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#C5D0D8" Offset="0" /><GradientStop Color="#AAB8C1" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="ButtonBackgroundPointerOver" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#D0E1EB" Offset="0" /><GradientStop Color="#B2C8D6" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="ButtonBackgroundPressed" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#9AAAB5" Offset="0" /><GradientStop Color="#879AA7" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#8097A6" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#168ED0" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#0066A3" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#102235" />
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#087FE5" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#1697F0" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0066A3" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#0066A3" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#005889" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#004B76" />
            <LinearGradientBrush x:Key="ControlFillColorDefaultBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#B9C6CE" Offset="0" /><GradientStop Color="#A5B3BC" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#DFE8EF" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#8097A6" />
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#C0CED8" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#087A42" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#0A9F55" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#1B7F50" />
            <LinearGradientBrush x:Key="WintainiumY2KChromeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#D7E0E5" Offset="0" /><GradientStop Color="#7D8E98" Offset="0.45" /><GradientStop Color="#B8C5CC" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="WintainiumY2KChromeHighlightBrush" Color="#E8F2F7" />
            <SolidColorBrush x:Key="WintainiumY2KChromeEdgeBrush" Color="#607887" />
            <SolidColorBrush x:Key="WintainiumY2KElectricBlueBrush" Color="#0066A3" />
            <SolidColorBrush x:Key="WintainiumY2KVioletBrush" Color="#765CFF" />
            <SolidColorBrush x:Key="WintainiumY2KMatrixGreenBrush" Color="#18C96B" />
            <SolidColorBrush x:Key="WintainiumY2KOrangeBrush" Color="#E86F1D" />
            <SolidColorBrush x:Key="WintainiumY2KBlueGlowBrush" Color="#73CCFF" />
            <SolidColorBrush x:Key="WintainiumY2KGridLineBrush" Color="#356F90" Opacity="0.30" />
            <SolidColorBrush x:Key="WintainiumY2KGridAccentBrush" Color="#009DFF" Opacity="0.55" />
            <SolidColorBrush x:Key="WintainiumY2KSuccessBrush" Color="#139B59" />
            <SolidColorBrush x:Key="WintainiumY2KWarningBrush" Color="#C76516" />
            <SolidColorBrush x:Key="WintainiumY2KErrorBrush" Color="#C83D4D" />
            <CornerRadius x:Key="ControlCornerRadius">9</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">14</CornerRadius>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <LinearGradientBrush x:Key="ApplicationPageBackgroundThemeBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#111D2B" Offset="0" /><GradientStop Color="#09131F" Offset="0.35" /><GradientStop Color="#07111C" Offset="0.62" /><GradientStop Color="#160F2D" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="WintainiumY2KPageGlowBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1A3044" Offset="0" /><GradientStop Color="#0C1E2E" Offset="0.5" /><GradientStop Color="#1B1235" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="CardBackgroundFillColorDefaultBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1C3042" Offset="0" /><GradientStop Color="#132433" Offset="0.4" /><GradientStop Color="#0D1926" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#3B6F93" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#183248" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#009DFF" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#103A5D" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#0D253A" />
            <LinearGradientBrush x:Key="ControlFillColorDefaultBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1A2D3F" Offset="0" /><GradientStop Color="#112130" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#1A3043" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#3B6F93" />
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#294D67" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F1F7FC" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#B7D1E4" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#7FA2BA" />
            <LinearGradientBrush x:Key="WintainiumY2KChromeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#C7D4DC" Offset="0" /><GradientStop Color="#718493" Offset="0.38" /><GradientStop Color="#405363" Offset="0.6" /><GradientStop Color="#AFC0CB" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="WintainiumY2KChromeHighlightBrush" Color="#E7F4FC" />
            <SolidColorBrush x:Key="WintainiumY2KChromeEdgeBrush" Color="#49677D" />
            <SolidColorBrush x:Key="WintainiumY2KElectricBlueBrush" Color="#00B7FF" />
            <SolidColorBrush x:Key="WintainiumY2KVioletBrush" Color="#8C6CFF" />
            <SolidColorBrush x:Key="WintainiumY2KMatrixGreenBrush" Color="#39FF9A" />
            <SolidColorBrush x:Key="WintainiumY2KOrangeBrush" Color="#FF8B36" />
            <SolidColorBrush x:Key="WintainiumY2KBlueGlowBrush" Color="#42C7FF" />
            <SolidColorBrush x:Key="WintainiumY2KGridLineBrush" Color="#31B6FF" Opacity="0.20" />
            <SolidColorBrush x:Key="WintainiumY2KGridAccentBrush" Color="#00B7FF" Opacity="0.34" />
            <SolidColorBrush x:Key="WintainiumY2KSuccessBrush" Color="#39FF9A" />
            <SolidColorBrush x:Key="WintainiumY2KWarningBrush" Color="#FF8B36" />
            <SolidColorBrush x:Key="WintainiumY2KErrorBrush" Color="#FF5D73" />
            <CornerRadius x:Key="ControlCornerRadius">9</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">14</CornerRadius>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <Style TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource WintainiumY2KCardCornerRadius}" />
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="{ThemeResource WintainiumY2KControlCornerRadius}" />
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="Consolas" />
    </Style>
    <CornerRadius x:Key="WintainiumY2KCardCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="WintainiumY2KControlCornerRadius">9</CornerRadius>
    <Style x:Key="WintainiumY2KButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource WintainiumY2KControlCornerRadius}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="WintainiumY2KAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource WintainiumY2KButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource WintainiumY2KElectricBlueBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style x:Key="WintainiumY2KCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource WintainiumY2KCardCornerRadius}" />
    </Style>
</ResourceDictionary>